generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  isAdmin      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  entries      WeekEntry[]
  draftPicks   DraftPick[]
}

model Golfer {
  id         String             @id @default(cuid())
  externalId String?
  name       String
  createdAt  DateTime           @default(now())
  tournaments TournamentGolfer[]
}

model Tournament {
  id                String             @id @default(cuid())
  name              String
  externalId        String?            @unique
  startDate         DateTime
  endDate           DateTime
  buyIn             Int                @default(5000) // stored in cents
  status            String             @default("UPCOMING") // UPCOMING, DRAFT_OPEN, IN_PROGRESS, COMPLETE
  cutLine           Int?
  lastScoresSyncAt  DateTime?
  createdAt         DateTime           @default(now())
  entries           WeekEntry[]
  golfers           TournamentGolfer[]
  draft             Draft?
}

model TournamentGolfer {
  id           String      @id @default(cuid())
  tournamentId String
  golferId     String
  scoreToPar   Int?
  currentRound Int?
  thru         String?
  madeTheCut   Boolean?
  position     String?
  isWithdrawn  Boolean     @default(false)
  tournament   Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  golfer       Golfer      @relation(fields: [golferId], references: [id], onDelete: Cascade)
  picks        Pick[]
  draftPicks   DraftPick[]

  @@unique([tournamentId, golferId])
}

model WeekEntry {
  id              String     @id @default(cuid())
  userId          String
  tournamentId    String
  hasPaid         Boolean    @default(false)
  isDisqualified  Boolean    @default(false)
  totalScore      Int?
  finishPosition  Int?
  payout          Int?       // in cents
  createdAt       DateTime   @default(now())
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournament      Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  picks           Pick[]

  @@unique([userId, tournamentId])
}

model Pick {
  id                 String           @id @default(cuid())
  weekEntryId        String
  tournamentGolferId String
  pickOrder          Int              // 1 or 2
  weekEntry          WeekEntry        @relation(fields: [weekEntryId], references: [id], onDelete: Cascade)
  tournamentGolfer   TournamentGolfer @relation(fields: [tournamentGolferId], references: [id], onDelete: Cascade)

  @@unique([weekEntryId, pickOrder])
}

model Draft {
  id                   String      @id @default(cuid())
  tournamentId         String      @unique
  status               String      @default("PENDING") // PENDING, IN_PROGRESS, COMPLETE
  mode                 String      @default("LIVE") // LIVE, ASYNC
  currentRound         Int         @default(1)
  currentPickIndex     Int         @default(0)
  draftOrder           String      @default("[]") // JSON array of user IDs
  pickTimeLimit        Int         @default(120) // seconds (120 for live, 14400 for async)
  currentPickDeadline  DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  tournament           Tournament  @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  picks                DraftPick[]
}

model DraftPick {
  id                 String           @id @default(cuid())
  draftId            String
  userId             String
  tournamentGolferId String
  overallPickNumber  Int
  round              Int
  pickedAt           DateTime         @default(now())
  draft              Draft            @relation(fields: [draftId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  tournamentGolfer   TournamentGolfer @relation(fields: [tournamentGolferId], references: [id], onDelete: Cascade)
}
